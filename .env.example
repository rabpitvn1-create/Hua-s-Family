GEMINI_API_KEY=
GEMINI_IMAGE_API_KEY=

# Model viết văn: không dùng model Lite để tránh giảm chất lượng câu chữ.
GEMINI_WRITER_MODEL=gemini-3.6-flash
# Có thể khai báo nhiều model không-Lite, phân cách bằng dấu phẩy.
GEMINI_WRITER_MODELS=gemini-3.6-flash

# Model đạo diễn logic và chỉ số. Lite được ưu tiên để tiết kiệm quota.
GEMINI_DIRECTOR_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_DIRECTOR_RETRY_ATTEMPTS=2
GEMINI_WRITER_RETRY_ATTEMPTS=2

# Biến cũ vẫn được hỗ trợ để tương thích deployment hiện tại.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_RETRY_ATTEMPTS=2

# Chỉ cần khi frontend và backend chạy ở hai tên miền khác nhau.
ALLOWED_ORIGINS=https://rabpitvn1-create.github.io,http://localhost:3000
